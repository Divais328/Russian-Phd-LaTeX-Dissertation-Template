ds, Rudy and Wouterloot, Jan G. A. and Yu, Chen-Yu and Yu (于威), Wei and Zeballos, Milagros},
  date = {2022-05-01},
  journaltitle = {The Astrophysical Journal Letters},
  shortjournal = {ApJL},
  volume = {930},
